# Copy to .env and adjust as needed. Defaults match the local docker-compose setup.
# Real environment variables (CI, production) override anything set here.

# Dev-only. Generate a real one for deployments:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=django-insecure-unsecure

# DEBUG=True is the dev default. Set False for any real deployment.
DEBUG=True
# Comma-separated hostnames. "*" (dev default) lets the Prometheus container
# scrape the host-run app via host.docker.internal. Set explicit hosts for deploys.
ALLOWED_HOSTS=*

LANGUAGE_CODE=en-us
TIME_ZONE=America/Santiago

# Structured JSON logs to logs/app.log, tailed by Alloy into Loki.
LOG_JSON_FILE=True
# Where those JSON logs land. Defaults to <repo>/logs; the Alloy container
# bind-mounts that path, so changing it means updating docker-compose too.
# LOG_DIR=logs
# Root/app log level. Defaults to INFO; set DEBUG for verbose app logs
# (django.db.backends, django.utils.autoreload and django.template stay at
# INFO regardless).
# LOG_LEVEL=INFO

# Django admin. Off by default; the route is only mounted when ADMIN_ENABLED is
# true, on ADMIN_URL rather than the scanned "/admin/". Turn it on for local
# admin work (needs an auth superuser: `manage.py createsuperuser`).
ADMIN_ENABLED=False
# ADMIN_URL=backoffice/

# Django connects on the host; docker-compose also feeds POSTGRES_DB/USER/PASSWORD
# into the postgres container and into pgAdmin's servers.json + pgpass.
POSTGRES_DB=backend_devops_interview
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# pgAdmin (docker compose) login. Compose-only, Django ignores these.
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=postgres

# Grafana (docker compose). Dashboards open anonymously; editing needs this login.
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# compose.prod.yml (the containerised-app overlay) only. Ignored by host dev.
# WEB_PORT=8000
# WEB_CONCURRENCY=3
